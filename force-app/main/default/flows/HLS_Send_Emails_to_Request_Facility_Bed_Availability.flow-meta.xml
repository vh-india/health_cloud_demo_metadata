<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Calls an action that emails the default workflow user specified in Process Automation Settings in Setup when GetCareFacilityBedRecords fails. If there&apos;s no specified default workflow user, then the email is sent to the automated process user email address specified in Process Automation Settings in Setup. To customize the error email, change the values specified for the Subject and Body parameters.</description>
        <name>SendErrorEmail</name>
        <label>Send Error Email</label>
        <locationX>440</locationX>
        <locationY>360</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>$User.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>Send Care Facility Beds Email to Accounts flow failed</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <stringValue>There was an error getting the care facility bed records so we couldn&apos;t email the healthcare facilities.</stringValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Adds the account ID of the healthcare facility associated with the current care facility bed to HealthcareFacilityAccountIds.</description>
        <name>AddAccountIdToCollection</name>
        <label>Add Account ID to Collection</label>
        <locationX>440</locationX>
        <locationY>576</locationY>
        <assignmentItems>
            <assignToReference>HealthcareFacilityAccountIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>IterateOverCareFacilityBedRecords.HealthcareFacility.AccountId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>IterateOverCareFacilityBedRecords</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Determines whether the account ID associated with the current care facility bed record is in the HealthcareFacilityAccountIds collection.</description>
        <name>IsCurrentAccountIdInCollection</name>
        <label>Is Current Account ID in Collection?</label>
        <locationX>352</locationX>
        <locationY>468</locationY>
        <defaultConnector>
            <targetReference>AddAccountIdToCollection</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>IsInCollection</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>HealthcareFacilityAccountIds</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>IterateOverCareFacilityBedRecords.HealthcareFacility.AccountId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IterateOverCareFacilityBedRecords</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>HLS - Send Emails to Request Facility Bed Availability {!$Flow.CurrentDateTime}</interviewLabel>
    <label>HLS - Send Emails to Request Facility Bed Availability</label>
    <loops>
        <description>Repeats actions in a loop for each care facility bed record in Care Facility Beds from GetCareFacilityBedRecords.</description>
        <name>IterateOverCareFacilityBedRecords</name>
        <label>Iterate Over Care Facility Bed Records</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <collectionReference>GetCareFacilityBedRecords</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>IsCurrentAccountIdInCollection</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>SendEmailToAcctContc</targetReference>
        </noMoreValuesConnector>
    </loops>
    <overriddenFlow>hc_crisis_center__EmailRqstForBedAvl</overriddenFlow>
    <processMetadataValues>
